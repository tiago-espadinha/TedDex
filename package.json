{
  "name": "teddex",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first, installable PWA Pokédex and team builder, built mobile-first for iPhone.",
  "homepage": "https://teddex.vercel.app",
  "license": "MIT",
  "author": "Tiago Espadinha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiago-espadinha/TedDex.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "data": "tsx scripts/build-data.ts",
    "media": "tsx scripts/build-media.ts",
    "league": "tsx scripts/build-league.ts",
    "item-places": "tsx scripts/build-item-places.ts",
    "availability": "tsx scripts/build-availability.ts",
    "dex-sprites": "tsx scripts/build-dex-sprites.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.19",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
